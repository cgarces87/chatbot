# ============================================================
#  CONFIGURACION DEL CHATBOT  (copia este archivo como .env)
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=pega_aqui_tu_api_key
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=Eres un asistente amable y servicial que responde por WhatsApp de forma breve, clara y en español. Si no sabes algo, dilo con honestidad.
MAX_HISTORY=10
# Reconocer imagenes y audios, y responder en grupos (true/false)
ENABLE_IMAGES=true
ENABLE_AUDIO=true
REPLY_IN_GROUPS=false

# --- WhatsApp / openwa-api ---
OPENWA_API_URL=https://tu-openwa-api.com
OPENWA_API_KEY=pega_aqui_tu_apikey_de_openwa
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=cambia-esto-por-un-texto-largo-secreto

# --- Servidor / exposicion a internet ---
PORT=3000
# true  = tunel de Cloudflare automatico (local/pruebas)
# false = usa PUBLIC_URL (produccion con dominio propio)
USE_TUNNEL=true
PUBLIC_URL=

# --- Panel de administracion web ---
# Rol ADMINISTRACION (acceso total)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Rol GESTION (solo lectura: ve el estado, NO modifica ni ve configuraciones)
GESTION_USER=gestion
GESTION_PASSWORD=cambia-esta-clave-gestion

# ============================================================
#  Memoria / almacenamiento
# ============================================================
# json     = archivo local (sencillo, sin instalar nada)
# postgres = PostgreSQL (recomendado: durable + metricas)
STORAGE_DRIVER=postgres

# Solo si STORAGE_DRIVER=json
CONV_STORE_FILE=data/conversations.json

# Solo si STORAGE_DRIVER=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chatbot
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MAX=10
